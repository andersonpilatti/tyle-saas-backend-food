<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="github" value="https://nuget.pkg.github.com/andersonpilatti/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github"><package pattern="Tyle.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GH_PACKAGES_USERNAME%" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
